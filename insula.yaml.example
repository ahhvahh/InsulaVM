# Example: profile debian-minimal must be registered from an already-installed
# QCOW2 disk. With -host supplied, a prepared guest is used instead.
# Repository transfer and installation from ISO are not yet implemented.
profile: debian-minimal
repository:
  name: example-repo
action: test
workspace: /app/repo-workspace
# Optional: import a directory (its CONTENTS) or a single file from
# the host to the VM before setup and jobs. Uncomment and adapt:
# imports:
#   - source: /home/user/my-project
#     destination: /app/repo-workspace
#   - source: /home/user/settings.ini
#     destination: /tmp/config
setup:
  - "echo Debian environment is ready"
pipelines:
  - name: validation
    jobs:
      - name: run-tests
        commands:
          - "python3 -m pytest"
          - "echo tests finished"
        allow_failure: false
      - name: inspect
        commands:
          - "pwd"
          - "ls -la"
        allow_failure: true
