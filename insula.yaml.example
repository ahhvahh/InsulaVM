# InsulaVM Action manifest. The VM profile is an installed QCOW2 with Cloud-Init.
# All imports and jobs use guest.destination from the global config.yaml.
# SSH user defaults to config.yaml ssh.user (insula if omitted).
# SSH private keys are automatically generated for managed VM instances.
profile: debian-minimal

repository:
  name: example-repo
action: test

# Optional: provision a different non-root SSH account for THIS Action.
# Do not put SSH keys or passwords in this manifest.
# ssh:
#   user: buildagent

# Optional host file(s)/directory(ies) to import to config.yaml guest.destination
# before setup/jobs. Files are added to the same guest destination directory.
# imports:
#   - source: /home/user/my-project
#   - source: /home/user/settings.ini

setup:
  - "echo Debian environment is ready"
pipelines:
  - name: validation
    jobs:
      - name: run-tests
        commands:
          - "python3 -m pytest"
          - "echo tests finished"
        allow_failure: false
      - name: inspect
        commands:
          - "pwd"
          - "ls -la"
        allow_failure: true
